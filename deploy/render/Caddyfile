# Front door inside the one container. The host (Render) already provides HTTPS, so Caddy only routes:
#   /api/*  -> the API on 8000      everything else -> the web app on 3000
{
	auto_https off
	admin off
}

:{$PORT:10000} {
	encode zstd gzip
	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(self), microphone=(), geolocation=()"
		-Server
	}
	handle /api/* {
		request_body {
			max_size 12MB
		}
		reverse_proxy 127.0.0.1:8000
	}
	handle {
		reverse_proxy 127.0.0.1:3000
	}
}
