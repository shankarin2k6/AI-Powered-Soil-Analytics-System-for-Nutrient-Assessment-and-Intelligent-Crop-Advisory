# Copy to backend/.env and edit.
DATABASE_URL=postgresql+psycopg://soil:soil@localhost:5432/soil
STORAGE_DIR=uploads
CORS_ORIGINS=http://localhost:3000

# Login. Make a long random value for SECRET_KEY:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Never reuse the development default on a real server.
SECRET_KEY=dev-only-secret-change-me-before-deploying
# On the real server set ENVIRONMENT=production and COOKIE_SECURE=true (needs https://).
# The app then refuses to start with the default SECRET_KEY.
ENVIRONMENT=development
COOKIE_SECURE=false
